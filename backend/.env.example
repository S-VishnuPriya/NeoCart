# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/neocart?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="neocart_super_secret_access_key_2026"
JWT_REFRESH_SECRET="neocart_super_secret_refresh_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client Application URL (For CORS)
FRONTEND_URL="http://localhost:5173"
